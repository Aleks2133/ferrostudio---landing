---
import { getLang, useTranslations } from '../i18n';

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
---
<div id="cookie-banner" class="ckb" hidden>
  <p class="ckb__text">
    {t('cookie.text')}
    {/* Polityka istnieje tylko po polsku — `lang` na linku mówi o tym
        czytnikom ekranu i wyszukiwarkom. */}
    <a href="/cookies" lang="pl">{t('cookie.link')}</a>
  </p>
  <button type="button" class="ckb__btn" data-ckb-accept>{t('cookie.ok')}</button>
</div>

<style>
  .ckb {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 60;
    margin-inline: auto;
    max-width: 640px;
    background: var(--color-onyx);
    color: var(--color-bg);
    padding: 1rem 1.15rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.25rem;
    box-shadow: 0 12px 40px -12px rgba(0, 0, 0, 0.35);
    transform: translateY(140%);
    transition: transform 0.45s var(--ease-out-quint);
  }
  .ckb.is-in { transform: none; }

  /* Na telefonie baner w dwóch rzędach zajmował ~27% ekranu i przykrywał CTA
     w hero. Jeden rząd: tekst + zwarty przycisk obok. */
  @media (max-width: 640px) {
    .ckb {
      left: 0.5rem;
      right: 0.5rem;
      bottom: 0.5rem;
      padding: 0.6rem 0.7rem;
      gap: 0.6rem;
      flex-wrap: nowrap;
      align-items: center;
    }
    .ckb__text { flex: 1 1 auto; font-size: 0.6875rem; line-height: 1.45; }
    .ckb__btn { flex: 0 0 auto; padding: 0.5rem 0.8rem; font-size: 0.75rem; }
  }
  .ckb__text {
    flex: 1 1 260px;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: rgba(237, 234, 227, 0.82);
  }
  .ckb__text a { color: var(--color-rust-lite); text-decoration: underline; text-underline-offset: 2px; }
  .ckb__btn {
    flex: 0 0 auto;
    /* Kość, nie rdza: zgoda na cookies nie jest akcją, na którą wydajemy
       jedyny rdzawy akcent w widoku (dyscyplina koloru, brief 6.2). */
    background: var(--color-bg);
    color: var(--color-onyx);
    border: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.7rem 1.3rem;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .ckb__btn:hover { background: #fff; }

  @media (prefers-reduced-motion: reduce) {
    .ckb { transition: none; }
  }
</style>

<script>
  const KEY = 'ferro-cookie-ack';
  const el = document.getElementById('cookie-banner');
  if (el) {
    let acked = false;
    try { acked = localStorage.getItem(KEY) === '1'; } catch (e) {}
    if (!acked) {
      el.hidden = false;
      // Baner stoi na fixed nad treścią i na telefonie przykrywał drugie CTA
      // w hero. Klasa na <html> pozwala układom zarezerwować sobie miejsce
      // tylko wtedy, gdy baner faktycznie wisi.
      document.documentElement.classList.add('has-ckb');
      requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-in')));
      el.querySelector('[data-ckb-accept]')?.addEventListener('click', () => {
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
        el.classList.remove('is-in');
        document.documentElement.classList.remove('has-ckb');
        window.dispatchEvent(new Event('ferro-cookie-ack'));
        setTimeout(() => { el.hidden = true; }, 450);
      });
    }
  }
</script>
