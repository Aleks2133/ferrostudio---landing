---
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import path from 'node:path';
import { getLang } from '../i18n';

/**
 * Odcisk zawartości `public/js/hero.mjs` doklejany do adresu skryptu.
 *
 * Pliki z `public/` nie dostają hasha w nazwie, a `.htaccess` cache'uje je
 * na godzinę (świadoma decyzja — patrz komentarz przy regułach cache).
 * Skutek przy wydawaniu poprawek: przez godzinę część użytkowników widzi
 * STARĄ scenę, mimo że na serwerze leży już nowa. Zmiana pliku zmienia
 * hash, a więc i adres — nowa wersja dociera natychmiast, a niezmieniony
 * plik dalej korzysta z cache.
 */
/* Ścieżka liczona od katalogu projektu, nie od `import.meta.url` — przy
   budowaniu ten moduł jest już spakowany do `dist/.prerender/chunks/`,
   więc ścieżka względna wskazywałaby w próżnię. */
const heroJsV = createHash('sha1')
  .update(readFileSync(path.join(process.cwd(), 'public', 'js', 'hero.mjs')))
  .digest('hex')
  .slice(0, 8);

/**
 * Copy hero w dwóch językach. Sama scena 3D jest niezależna od języka —
 * wycina logotyp z pliku, nie z tekstu — więc tłumaczymy wyłącznie warstwę
 * tekstową i etykietę przycisku odtworzenia.
 *
 * H1 jest łamany ręcznie na trzy linie (`.rl`), bo mechanizm „reveal cięciem"
 * odsłania linia po linii. Automatyczne zawijanie zepsułoby rytm odsłaniania,
 * dlatego wersja angielska też ma trzy własne linie, a nie tłumaczenie
 * wrzucone w jeden akapit.
 *
 * Układ: na desktopie scena leży POD całym hero (`.hero__stage` na absolute),
 * a copy stoi w lewej kolumnie. Na telefonie scena dostaje WŁASNY wiersz
 * siatki nad tekstem — wcześniej leżała pod wszystkim i płyta renderowała się
 * dokładnie na wysokości nagłówka (zmierzone: H1 y=152–274, płyta y≈98–298).
 * Logika sceny jest w /js/hero.mjs.
 */
const copy = {
  pl: {
    lines: ['Precyzja,', 'którą widać', 'z bliska'],
    lead: 'Projektujemy i wycinamy w metalu. Logotypy, napisy i dekoracje ścienne — od pliku do zamontowanego detalu. Wysyłka w całej Polsce.',
    ctaPrimary: 'Zamów wycenę',
    ctaPrimaryHref: '/wycena',
    ctaGhost: 'Zobacz realizację',
    ctaGhostHref: '/#realizacja',
    offer: ['Logotypy firmowe', 'Napisy i litery', 'Dekoracje ścienne'],
    replay: 'Odtwórz cięcie',
  },
}[getLang(Astro.url.pathname)];
---

<section class="hero on-onyx" aria-labelledby="hero-heading">
  <div class="hero__stage">
    <div class="hero__scene" id="hero-scene" aria-hidden="true"></div>
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__grid">
    <div class="hero__col">
      <h1 id="hero-heading" class="hero__title">
        {copy.lines.map((l) => <span class="rl"><span>{l}</span></span>)}
      </h1>

      <p class="hero__lead">{copy.lead}</p>

      <div class="hero__cta">
        <a href={copy.ctaPrimaryHref} class="btn btn-primary">{copy.ctaPrimary}</a>
        <a href={copy.ctaGhostHref} class="btn btn-ghost">{copy.ctaGhost}</a>
      </div>

      <ul class="hero__offer">
        {copy.offer.map((o) => <li>{o}</li>)}
      </ul>
    </div>
  </div>

  <button type="button" class="hero__replay" id="hero-replay" hidden>
    <span aria-hidden="true">&#8635;</span> {copy.replay}
  </button>

  <span class="hero__scroll" aria-hidden="true"><span>&darr;</span></span>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(90svh, 860px);
    display: flex;
    align-items: center;
    padding-block: 2rem 4rem;
    overflow: hidden;
  }

  /* Scena + przyciemnienie jako jedna warstwa. Dzięki temu na telefonie
     wystarczy przestawić `.hero__stage` w wiersz siatki i scrim jedzie
     razem ze sceną, zamiast rozlewać się na cały ekran pod tekstem. */
  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Live laser-cut scene. Absolutely placed, so it can never shift layout —
     if WebGL or the CDN is unavailable the hero is simply the dark panel. */
  .hero__scene {
    position: absolute;
    inset: 0;
  }
  .hero__scene :global(canvas) {
    display: block;
    cursor: grab;
    touch-action: pan-y;
  }
  .hero__scene :global(canvas.is-dragging) { cursor: grabbing; }

  .hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(100deg, var(--color-onyx) 8%, rgba(25, 24, 21, 0.72) 34%, rgba(25, 24, 21, 0) 62%),
      radial-gradient(120% 90% at 50% 50%, rgba(25, 24, 21, 0) 45%, rgba(25, 24, 21, 0.75) 100%);
  }

  .hero__grid {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 5rem);
    pointer-events: none;
  }
  .hero__grid a { pointer-events: auto; }

  /* everything animates via CSS on load — no JS dependency */
  .hero__lead,
  .hero__cta,
  .hero__offer { opacity: 0; animation: rise 0.7s var(--ease-out-quint) forwards; }
  .hero__lead { animation-delay: 0.5s; }
  .hero__cta { animation-delay: 0.62s; }
  .hero__offer { animation-delay: 0.74s; }

  .hero__title {
    font-size: clamp(2.75rem, 8vw, 7rem);
    line-height: 0.92;
    margin: 0.35em 0 0.45em;
    letter-spacing: -0.02em;
  }
  .hero__title .rl { display: block; overflow: hidden; }
  .hero__title .rl > span {
    display: block;
    white-space: nowrap;
    transform: translateY(105%);
    animation: line-up 0.85s var(--ease-out-quint) forwards;
  }
  .hero__title .rl:nth-child(1) > span { animation-delay: 0.15s; }
  .hero__title .rl:nth-child(2) > span { animation-delay: 0.27s; }
  .hero__title .rl:nth-child(3) > span { animation-delay: 0.39s; }

  .hero__lead {
    max-width: 40ch;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: color-mix(in srgb, var(--color-bg) 72%, transparent);
  }

  .hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.25rem; }

  /* Trzy osobne etykiety rozdzielone cienką kreską — ciąg łączony środkowymi
     kropkami czyta się jak stopka szablonu. */
  .hero__offer {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid rgba(237, 234, 227, 0.18);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-bg) 55%, transparent);
  }
  .hero__offer li + li {
    padding-left: 1.5rem;
    border-left: 1px solid rgba(237, 234, 227, 0.22);
  }

  /* Kontrolka sceny — pojawia się dopiero, gdy scena faktycznie wstała. */
  .hero__replay {
    position: absolute;
    z-index: 3;
    right: clamp(1rem, 4vw, 2.5rem);
    bottom: clamp(1rem, 4vw, 2.5rem);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    background: transparent;
    border: 1px solid rgba(237, 234, 227, 0.28);
    color: color-mix(in srgb, var(--color-bg) 70%, transparent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .hero__replay:hover {
    border-color: var(--color-rust-lite);
    color: var(--color-bg);
  }
  .hero__replay[hidden] { display: none; }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    z-index: 2;
    translate: -50% 0;
    color: color-mix(in srgb, var(--color-bg) 55%, transparent);
    font-size: 1rem;
    opacity: 0;
    animation: fade 0.6s ease 1.1s forwards;
  }
  .hero__scroll span { display: block; animation: bob 2s ease-in-out infinite; }

  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes line-up { to { transform: none; } }
  @keyframes fade { to { opacity: 1; } }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }

  @media (min-width: 900px) {
    .hero__col { max-width: 34rem; }
    /* Baner cookies ucinał dolną listę usług także na desktopie. */
    :global(html.has-ckb) .hero__offer { margin-bottom: 3.5rem; }
  }

  /* ------------------------------------------------------------------ */
  /*  Telefon: scena ma własny pas nad tekstem                           */
  /* ------------------------------------------------------------------ */
  /* Wcześniej scena leżała pod całym hero, a scrim był NAJBARDZIEJ
     przezroczysty dokładnie na wysokości nagłówka (26% viewportu) — czyli
     kompozycja walczyła sama ze sobą. Teraz siatka dwuwierszowa: pas sceny
     u góry (kamera wjeżdża tam w makro cięcia), copy pod spodem.
     Lista ofert schodzi z hero — te same trzy usługi są w sekcji „co robimy". */
  @media (max-width: 899px) {
    .hero {
      /* Pas musi pomieścić CAŁĄ płytę (arkusz stali) z powietrzem dookoła —
         wtedy detal „lewituje" jak na desktopie, zamiast wypełniać ciasny
         pasek po brzegi (co czytało się jak kadr z filmu).
         Skala idzie za szerokością ekranu (bo to ona ogranicza płytę),
         ale `min()` z jednostką wysokości pilnuje, żeby na niskich
         telefonach pas nie zjadł miejsca potrzebnego na CTA. */
      --hero-band: clamp(165px, min(58vw, 30svh), 330px);
      display: grid;
      grid-template-rows: var(--hero-band) auto;
      align-items: stretch;
      /* Domyślne `align-content: normal` na gridzie liczy się jak `stretch`:
         drugi wiersz ("auto") rozciągał się na CAŁĄ wolną przestrzeń, jaką
         dawał `min-height`, a że `.hero__grid` ma `align-self: end`, tekst
         lądował na dole tej rozciągniętej przestrzeni — stąd ogromna, pusta
         luka między pasem a nagłówkiem, niezależna od samego kadrowania loga.
         `start` każe wierszom trzymać naturalną wysokość; nadmiar miejsca
         (jeśli jest) ląduje na SAMYM DOLE sekcji, nie między pasem a tekstem. */
      align-content: start;
      /* Nie 100svh: sekcja zaczyna się POD sticky headerem (64px), więc pełne
         100svh wypychało dół hero pod krawędź ekranu razem z CTA. */
      min-height: calc(100svh - 64px);
      padding-block: 0 1.25rem;
      row-gap: 1rem;
    }

    .hero__stage {
      position: relative;
      inset: auto;
      grid-row: 1;
      overflow: hidden;
    }
    /* Winieta zamiast poziomego gradientu: narożniki i brzegi gasną w onyks
       ze WSZYSTKICH stron, więc pas przestaje mieć wyczuwalną ramkę. Bez tego
       scena czytała się jak wklejony prostokąt („kadr z filmu"), a nie jak
       ciemna przestrzeń, w której coś wisi. */
    .hero__scrim {
      background:
        radial-gradient(
          118% 88% at 50% 46%,
          rgba(25, 24, 21, 0) 34%,
          rgba(25, 24, 21, 0.5) 76%,
          var(--color-onyx) 100%
        ),
        linear-gradient(
          180deg,
          var(--color-onyx) 0%,
          rgba(25, 24, 21, 0) 20%,
          rgba(25, 24, 21, 0) 72%,
          var(--color-onyx) 100%
        );
    }

    .hero__grid { grid-row: 2; align-self: end; }

    .hero__title { margin-top: 0; margin-bottom: 0.34em; }
    .hero__lead { font-size: 1rem; line-height: 1.55; }
    .hero__cta { margin-top: 1.15rem; gap: 0.75rem; }
    /* Węższy padding, żeby oba CTA zmieściły się w jednym rzędzie — dwa
       rzędy przycisków zjadały pas potrzebny scenie. */
    .hero__cta .btn { padding-inline: 1.05rem; font-size: 0.9rem; }

    .hero__offer { display: none; }
    /* Strzałka scrolla i tak lądowała pod banerem cookies. */
    .hero__scroll { display: none; }

    /* W pasku sceny przycisk ma być notatką na marginesie, nie elementem
       kompozycji — w pełnej skali przejmował cały kadr. */
    .hero__replay {
      top: calc(var(--hero-band, 32svh) - 2.05rem);
      bottom: auto;
      right: 0.75rem;
      padding: 0.35rem 0.55rem;
      gap: 0.35rem;
      font-size: 0.625rem;
      opacity: 0.5;
    }
    .hero__replay:hover { opacity: 1; }

    /* Bez sceny (brak WebGL / awaria bootu) pas byłby pustą dziurą na 28svh.
       Klasę ustawia /js/hero.mjs w ścieżce awaryjnej. */
    .hero.hero--nostage { --hero-band: 0px; row-gap: 0; }
    .hero--nostage .hero__stage,
    .hero--nostage .hero__replay { display: none; }

    /* Baner cookies (position:fixed, z-index 60) przykrywał drugie CTA.
       Rezerwa idzie na sekcję, nie na `.hero__grid` — inaczej wiersz z copy
       nie kurczy się i całość rośnie poza ekran. Klasę ustawia CookieBanner
       i zdejmuje ją po akceptacji. */
    :global(html.has-ckb) .hero { padding-bottom: 5.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__lead, .hero__cta, .hero__offer, .hero__scroll { opacity: 1; animation: none; }
    .hero__title .rl > span { transform: none; animation: none; }
    .hero__scroll span { animation: none; }
  }

  /* Przy ograniczonym ruchu scena w ogóle nie startuje — pas zwijamy w CSS,
     żeby nie było ani pustej dziury, ani przeskoku układu. */
  @media (max-width: 899px) and (prefers-reduced-motion: reduce) {
    .hero { --hero-band: 0px; row-gap: 0; }
    .hero__stage, .hero__replay { display: none; }
  }
</style>

{/* Import mapa dla `three` stoi w BaseLayout — jedna na dokument, bo od fazy 3
    na stronie głównej są dwie sceny (hero i teaser konfiguratora).
    Sama scena siedzi w /js/hero.mjs — tak samo jak teaser konfiguratora
    (public/js/teaser.mjs). Plik jest cache'owany osobno od HTML-a. */}
<script type="module" is:inline src={`/js/hero.mjs?v=${heroJsV}`}></script>
