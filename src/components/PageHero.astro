---
/**
 * Nagłówek podstrony, wersja 2.
 *
 * Zmiany wobec v1:
 *  - **wyrównanie do lewej** zamiast wyśrodkowania. Wyśrodkowany tekst zostaje
 *    w jednym miejscu na całej stronie (finalne CTA na home), dzięki czemu tam
 *    coś znaczy.
 *  - **bez eyebrow WERSALIKAMI**. Orientację daje numer/etykieta w notacji
 *    technicznej na marginesie, sentence case.
 *  - nagłówek w większej skali, lead szerszy i czytelniejszy.
 */
import Breadcrumbs from './Breadcrumbs.astro';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  breadcrumb: Crumb[];
  /** krótka etykieta techniczna nad nagłówkiem (mono, sentence case) */
  index?: string;
  /** cienka kreska pod treścią */
  rule?: boolean;
}
const { breadcrumb, index, rule = true } = Astro.props;
---

<section class="phero">
  <div class="container-x">
    <div class="phero__col" data-reveal>
      <Breadcrumbs items={breadcrumb} />
      {index && <p class="phero__idx mono">{index}</p>}
      <slot />
      {rule && <span class="rule"></span>}
    </div>
  </div>
</section>

<style>
  .phero {
    padding-block: clamp(2.25rem, 5vw, 3.5rem) clamp(1.5rem, 3.5vw, 2.5rem);
  }
  .phero__col { max-width: 52rem; }
  .phero__idx {
    margin-top: 1rem;
    color: var(--color-tin);
    letter-spacing: 0.08em;
  }
  .phero__col :global(h1) {
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    line-height: 0.95;
    margin-top: 0.6rem;
    max-width: 18ch;
  }
  .phero__col :global(.phero__lead) {
    margin-top: 1.1rem;
    color: color-mix(in srgb, var(--color-onyx) 74%, transparent);
    font-size: 1.0625rem;
    max-width: 56ch;
  }
  .phero__col :global(.phero__meta) {
    margin-top: 0.9rem;
    color: var(--color-tin);
    font-size: 0.875rem;
  }
  .phero__col .rule { margin-top: 1.5rem; }
</style>
