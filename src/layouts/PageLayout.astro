---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  eyebrow?: string;
  updated?: string;
}
const { title, description, heading, eyebrow, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PageHero breadcrumb={[{ label: heading }]} eyebrow={eyebrow ?? heading} rule={false}>
    <h1>{heading}</h1>
    {updated && <p class="phero__meta">Ostatnia aktualizacja: {updated}</p>}
  </PageHero>

  <section class="page section-y">
    <div class="container-x">
      <div class="page__col">
        <div class="prose">
          <slot />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page__col { max-width: 46rem; margin-inline: auto; }
</style>
