---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContactCta from '../components/sections/ContactCta.astro';
import { SITE } from '../config';

import workMain from '../assets/photos/realizacja-society-landscape.jpg';
import workProces from '../assets/photos/realizacja-society-landscape-proces.jpg';
import workDetal from '../assets/photos/realizacja-society-landscape-detal.jpg';
import workMagazyn02 from '../assets/photos/realizacja-society-landscape-magazyn-02.jpg';
import workLifestyle from '../assets/photos/realizacja-society-landscape-lifestyle.jpg';

const offer = [
  {
    title: 'Logotypy i napisy firmowe',
    body: 'Twoje logo albo nazwa wycięte w metalu — do recepcji, na elewację, do sali spotkań. Czyste krawędzie, montaż na dystansach lub płasko na ścianie.',
  },
  {
    title: 'Dekoracje ścienne',
    body: 'Panele ażurowe, formy geometryczne, motywy roślinne i grafika autorska. Pojedynczy element albo cała kompozycja na ścianę, do wnętrz prywatnych i komercyjnych.',
  },
  {
    title: 'Projekty indywidualne',
    body: 'Masz gotowy plik wektorowy albo tylko szkic? Przygotujemy projekt do cięcia, dobierzemy materiał i wykończenie, wytniemy i wykończymy.',
  },
];

const metals = [
  { name: 'Stal czarna', note: 'Najbardziej uniwersalna. Wymaga zabezpieczenia powierzchni.' },
  { name: 'Stal nierdzewna', note: 'Do wnętrz i na zewnątrz. Nie wymaga konserwacji.' },
  { name: 'Stal corten', note: 'Patynuje się w kontrolowany sposób. Żyje razem z budynkiem.' },
  { name: 'Aluminium', note: 'Lekkie — tam, gdzie ściana nie utrzyma stali.' },
  { name: 'Mosiądz', note: 'Najwyższa półka. Ciepły ton, starzeje się szlachetnie.' },
];

const work = [
  { src: workMain, alt: 'Odręczny znak firmowy Society Landscape wycięty w metalu, tuż po cięciu' },
  { src: workProces, alt: 'Panele znaku Society Landscape w trakcie malowania proszkowego' },
  { src: workDetal, alt: 'Zbliżenie na krawędź cięcia i wykończenie znaku Society Landscape' },
  { src: workMagazyn02, alt: 'Znak Society Landscape w magazynie marki' },
  { src: workLifestyle, alt: 'Zespół Society Landscape przy metalowym znaku marki' },
];

const services = ['Logotypy z metalu', 'Dekoracje ścienne z metalu', 'Cięcie metalu na zamówienie'].map(
  (name) => ({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name,
    provider: { '@id': `${SITE.url}/#business` },
    areaServed: { '@type': 'Country', name: SITE.areaServed },
  })
);

const faqs = [
  {
    q: 'Ile trwa realizacja?',
    a: 'Zwykle od 3 do 10 dni roboczych — zależy od wielkości, materiału i wykończenia. Prostsze projekty, jak znak dla Society Landscape, robimy nawet w 2 dni.',
  },
  {
    q: 'Jaki materiał wybrać?',
    a: 'Do wnętrz najczęściej stal czarna lub nierdzewna, na zewnątrz — corten albo nierdzewna. Jeśli nie wiesz, co pasuje do Twojego projektu, napisz — doradzimy na etapie wyceny.',
  },
  {
    q: 'Nie mam pliku wektorowego, tylko pomysł — wystarczy?',
    a: 'Tak. Prześlij zdjęcie, szkic albo po prostu opisz pomysł — na tej podstawie przygotujemy projekt gotowy do cięcia.',
  },
  {
    q: 'Ile to będzie kosztować?',
    a: 'Cena zależy od rozmiaru, materiału i wykończenia, więc wyceniamy indywidualnie. Wypełnij krótki brief w zakładce Wycena — odezwiemy się w 1–2 dni robocze.',
  },
  {
    q: 'Wysyłacie poza swoje miasto?',
    a: 'Tak, wysyłka odbywa się na terenie całej Polski.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Ferro Studio — logotypy i dekoracje z metalu ciętego na wymiar"
  description="Projektujemy i wycinamy w metalu: logotypy firmowe, napisy i dekoracje ścienne. Projekt indywidualny, precyzyjne wykonanie, wysyłka w całej Polsce."
  path="/"
  jsonLd={[...services, faqJsonLd]}
>
  <Hero />

  <section id="oferta" class="offer section-y">
    <div class="container-x">
      <SectionHeader index="01 / oferta" title="Co robimy" />
      <ul class="offer__list">
        {
          offer.map((it, i) => (
            <li class="offer__item" data-reveal style={`--i:${i}`}>
              <h3>{it.title}</h3>
              <p>{it.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="materialy" class="mats section-y">
    <div class="container-x">
      <SectionHeader index="02 / materiał" title="W czym wycinamy" />
      <dl class="mats__list">
        {
          metals.map((m, i) => (
            <div class="mats__row" data-reveal style={`--i:${i}`}>
              <dt>{m.name}</dt>
              <dd>{m.note}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mats__note">
        Grubość, wykończenie i sposób montażu dobieramy do konkretnego projektu na etapie wyceny.
      </p>
    </div>
  </section>

  <section id="realizacja" class="work section-y">
    <div class="container-x">
      <SectionHeader index="03 / realizacja" title="Society Landscape" />
      <div class="work__layout">
        <a href="/realizacje/society-landscape" class="work__hero" data-reveal aria-label="Zobacz pełną realizację Society Landscape">
          <figure>
            <Image
              src={work[0].src}
              alt={work[0].alt}
              widths={[480, 800, 1200]}
              sizes="(min-width:900px) 45vw, 100vw"
              loading="lazy"
            />
          </figure>
        </a>
        <div class="work__side">
          <p class="work__tag mono">Zaprzyjaźniona marka odzieżowa</p>
          <p class="work__lead" data-reveal="right">
            Odręczny, kaligraficzny znak firmowy wycięty w metalu dla{' '}
            <a href="https://societylandscape.pl" rel="noopener">Society Landscape</a> — do biura
            i na wyjazdowe popupy, w formie odpornej na deszcz i częste przewożenie.
          </p>
          <div class="work__thumbs">
            {
              work.slice(1).map((w, i) => (
                <a
                  href="/realizacje/society-landscape"
                  class="work__fig"
                  data-reveal="right"
                  style={`--i:${i + 1}`}
                  aria-label="Zobacz pełną realizację Society Landscape"
                >
                  <figure>
                    <Image
                      src={w.src}
                      alt={w.alt}
                      widths={[320, 480, 640]}
                      sizes="(min-width:900px) 22vw, 50vw"
                      loading="lazy"
                    />
                  </figure>
                </a>
              ))
            }
          </div>
          <a href="/realizacje/society-landscape" class="link-cut" data-reveal="right" style="--i:3">
            Zobacz pełną realizację →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="faq section-y">
    <div class="container-x">
      <div class="faq__head">
        <p class="faq__idx mono">często zadawane pytania</p>
        <h2>Zanim napiszesz</h2>
      </div>
      <div class="faq__list">
        {
          faqs.map((f, i) => (
            <details class="faq__item" data-reveal style={`--i:${i}`}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  .offer__list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }
  .offer__item h3 {
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    margin-bottom: 0.5rem;
  }
  .offer__item p {
    color: color-mix(in srgb, var(--color-onyx) 76%, transparent);
    max-width: 46ch;
  }
  @media (min-width: 860px) {
    .offer__list { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }

  .mats { background: var(--color-panel); }
  .mats__list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-line);
  }
  .mats__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem 1.5rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .mats__row dt { font-weight: 600; font-size: 1.05rem; }
  .mats__row dd {
    margin: 0;
    color: color-mix(in srgb, var(--color-onyx) 74%, transparent);
  }
  .mats__note {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    color: var(--color-tin);
    max-width: 52ch;
  }
  @media (min-width: 640px) {
    .mats__row { grid-template-columns: 14rem 1fr; align-items: baseline; }
  }

  .work__layout {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
  }
  .work__hero {
    display: block;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-panel);
  }
  .work__hero figure,
  .work__fig figure { margin: 0; }
  .work__hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 4 / 5;
  }
  .work__side { display: flex; flex-direction: column; }
  .work__tag {
    color: var(--color-tin);
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }
  .work__lead {
    max-width: 46ch;
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
    color: color-mix(in srgb, var(--color-onyx) 78%, transparent);
  }
  .work__lead a { color: var(--color-rust); text-decoration: underline; text-underline-offset: 2px; }
  .work__thumbs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }
  .work__fig { display: block; margin: 0; overflow: hidden; border-radius: 2px; }
  .work__fig img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 1 / 1;
  }
  @media (min-width: 900px) {
    .work__layout { grid-template-columns: 3fr 2fr; align-items: start; }
    .work__hero img { aspect-ratio: 4 / 4.5; }
    .work__side { justify-content: center; padding-left: 0.5rem; }
  }

  .faq { background: var(--color-panel); }
  .faq__idx { color: var(--color-tin); letter-spacing: 0.08em; margin-bottom: 0.75rem; }
  .faq__head { text-align: center; margin-bottom: 2.5rem; }
  .faq h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); margin-top: 0.6rem; }
  .faq__list {
    display: flex;
    flex-direction: column;
    max-width: 62ch;
    margin-inline: auto;
    border-top: 1px solid var(--color-line);
  }
  .faq__item { border-bottom: 1px solid var(--color-line); padding: 1.25rem 0; }
  .faq__item summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 1.05rem;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after {
    content: '+';
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-rust);
    flex: 0 0 auto;
    transition: transform 0.2s;
  }
  .faq__item[open] summary::after { transform: rotate(45deg); }
  .faq__item p { margin-top: 0.9rem; color: color-mix(in srgb, var(--color-onyx) 72%, transparent); }
</style>
