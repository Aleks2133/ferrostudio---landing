---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/sections/ContactCta.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { SITE } from '../config';

const faqs = [
  {
    q: 'Jak przesłać plik?',
    a: 'Wystarczy załącznik w mailu (PDF, AI, SVG) albo link do dysku. Jeśli nie masz jeszcze gotowego pliku — opisz pomysł, pomożemy go dopracować.',
  },
  {
    q: 'Czy wyceniacie bez gotowego projektu?',
    a: 'Tak. Wystarczy opis, przybliżony rozmiar i miejsce montażu — resztę ustalimy wspólnie na etapie wyceny.',
  },
  {
    q: 'Czy wysyłacie poza woj. łódzkie?',
    a: 'Tak, realizacje wysyłamy kurierem na terenie całej Polski.',
  },
  {
    q: 'Ile trwa realizacja?',
    a: 'Zależy od projektu, materiału i wykończenia — dokładny termin dostajesz razem z wyceną.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Kontakt — Ferro Studio"
  description="Napisz lub zadzwoń — wyceniamy logotypy, napisy i dekoracje z metalu w 1–2 dni robocze."
  path="/kontakt"
  jsonLd={faqJsonLd}
>
  <PageHero breadcrumb={[{ label: 'Kontakt' }]} index="kontakt">
    <h1>Porozmawiajmy<br />o Twoim projekcie</h1>
    <p class="phero__lead">
      Prześlij plik albo opisz pomysł — odezwiemy się z wyceną w 1–2 dni robocze.
    </p>
  </PageHero>

  <section class="intro section-y">
    <div class="container-x">
      <SectionHeader index="wybierz drogę" title="Dwie drogi do wyceny" />
      <div class="paths">
        <div class="paths__card" data-reveal>
          <h3>Szybkie pytanie</h3>
          <p>
            Coś doprecyzować albo zapytać, zanim wyślesz projekt? Napisz przez formularz poniżej
            albo zadzwoń — odpowiadamy szybko.
          </p>
          <a href={SITE.phoneHref} class="link-cut">{SITE.phone}</a>
        </div>
        <div class="paths__card" data-reveal="right">
          <h3>Konkretny projekt</h3>
          <p>
            Masz już pomysł na logotyp, napis albo dekorację? Brief prowadzi przez trzy pytania i
            od razu daje nam komplet informacji do wyceny.
          </p>
          <a href="/wycena" class="btn btn-primary">Wypełnij brief wyceny</a>
          <p class="paths__note">Dwie minuty. Konkretniejsza wycena, mniej dopytywania.</p>
        </div>
      </div>
    </div>
  </section>

  <ContactCta />

  <section class="faq section-y">
    <div class="container-x">
      <div class="faq__head">
        <p class="faq__idx mono">zanim napiszesz</p>
        <h2>Najczęstsze pytania</h2>
      </div>
      <div class="faq__list">
        {
          faqs.map((f, i) => (
            <details class="faq__item" data-reveal style={`--i:${i}`}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="trust section-y">
    <div class="container-x trust__row">
      <p class="trust__ship">Wysyłka na terenie całej Polski.</p>
      <div class="trust__links">
        <a href="/jak-zamawiac" class="link-cut">Zobacz, jak zamawiać</a>
        <a href="/wycena" class="link-cut">Wypełnij brief wyceny</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .paths {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2rem);
  }
  .paths__card {
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }
  .paths__card h3 { font-size: 1.25rem; }
  .paths__card p {
    color: color-mix(in srgb, var(--color-onyx) 76%, transparent);
    max-width: 40ch;
  }
  .paths__note { font-size: 0.8125rem; color: var(--color-tin); margin-top: -0.4rem; }
  @media (min-width: 700px) {
    .paths { grid-template-columns: repeat(2, 1fr); }
  }
  .faq__idx { color: var(--color-tin); letter-spacing: 0.08em; margin-bottom: 0.75rem; }
  .trust__links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; }

  .faq { background: var(--color-panel); }
  .faq__head { text-align: center; margin-bottom: 2.5rem; }
  .faq h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); margin-top: 0.6rem; }
  .faq__list {
    display: flex;
    flex-direction: column;
    max-width: 62ch;
    margin-inline: auto;
    border-top: 1px solid var(--color-line);
  }
  .faq__item {
    border-bottom: 1px solid var(--color-line);
    padding: 1.25rem 0;
  }
  .faq__item summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 1.05rem;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after {
    content: '+';
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-rust);
    flex: 0 0 auto;
    transition: transform 0.2s;
  }
  .faq__item[open] summary::after { transform: rotate(45deg); }
  .faq__item p {
    margin-top: 0.9rem;
    color: color-mix(in srgb, var(--color-onyx) 72%, transparent);
  }

  .trust__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .trust__ship { font-weight: 600; }

  section.trust { padding-block: clamp(2rem, 4vh, 2.75rem); }
</style>
